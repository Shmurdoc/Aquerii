# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Aquerii
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aquerii
DB_USERNAME=aquerii
DB_PASSWORD=
DB_SSLMODE=require

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Cache / Session / Queue ───────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis

# ── Auth / Sanctum ────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=app.example.com
FRONTEND_URL=https://app.example.com

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Storage (S3-compatible) ───────────────────────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=aquerii-uploads
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=

# ── PayFast ───────────────────────────────────────────────────────────────────
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=false

# ── AI Service (internal) ─────────────────────────────────────────────────────
AI_SERVICE_URL=http://ai:8002
AI_SERVICE_SECRET=

# ── Realtime Service (internal) ───────────────────────────────────────────────
REALTIME_SERVICE_URL=http://realtime:3001
REALTIME_SECRET=

# ── Super Admin (required in production — refused to seed without these) ──────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
DB_SUPERADMIN_USERNAME=aquerii_superadmin
DB_SUPERADMIN_PASSWORD=

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.example.com/auth/oauth/github/callback

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ── Gotenberg (PDF) ───────────────────────────────────────────────────────────
GOTENBERG_URL=http://gotenberg:3000

# ── ClickHouse ─────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=aquerii_analytics
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=CHANGEME_CLICKHOUSE_PASSWORD

# ── Module toggles ─────────────────────────────────────────────────────────────
# Set to `false` to disable a module entirely. Defaults to enabled if unset.
# WARNING: Disabling MODULE_HSSE in production will silently break the SA
# mining compliance reporting endpoints (COIDA W.Cl.2 + MHSA §11).
# WARNING: Disabling MODULE_PTW in production will silently break the SA
# mining Permit to Work state machine and the DMR Permit Register export.
MODULE_HSSE=true
MODULE_CRM=true
MODULE_PTW=true
